# ============================================================
# Git 忽略规则（告诉 Git 哪些文件不要纳入版本管理）
# ============================================================

# ---------- Python 后端 ----------
# 虚拟环境目录（每台机器自己创建，不进仓库）
backend/venv/
# Python 运行时生成的字节码缓存目录
__pycache__/
*.pyc
# 环境变量文件（含数据库密码，绝不进仓库！进仓库的是 .env.example）
backend/.env
# 本地测试数据库（旧的 SQLite 文件，已改用远程 MySQL）
backend/app/data/*.db

# ---------- 前端 ----------
# npm 安装的依赖目录（每台机器自己 npm install）
frontend/node_modules/
# 打包产物
frontend/dist/

# ---------- 编辑器 / 系统文件 ----------
.idea/
.vscode/
.DS_Store
