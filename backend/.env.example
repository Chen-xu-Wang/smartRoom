# ============================================================
# 环境变量配置模板（复制本文件并重命名为 .env，填入真实值）
# ------------------------------------------------------------
# 使用方法（Windows 命令行）：
#   copy .env.example .env
#   然后用编辑器打开 .env 修改各项配置
# ============================================================

# -------------------- 数据库配置（MySQL）--------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=SmartRoom
DB_POOL_SIZE=5

# -------------------- 后端服务配置 --------------------
HOST=0.0.0.0
PORT=8000

# -------------------- AI 大模型配置（暂未启用）--------------------
# LLM_API_KEY=你的API密钥
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
